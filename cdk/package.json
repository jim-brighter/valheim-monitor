{
  "name": "cdk",
  "version": "0.1.0",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest",
    "cdk": "cdk",
    "cdk:deploy": "cdk deploy --all --require-approval never --outputs-file outputs.json",
    "cdk:monitor-lambda:install": "cd ../monitor-lambda && npm i && cd ../cdk",
    "cdk:monitor-lambda:test": "cd ../monitor-lambda && npm test && cd ../cdk",
    "deploy": "npm run cdk:monitor-lambda:install && npm run cdk:monitor-lambda:test && npm run cdk:deploy",
    "synth": "npm run cdk:monitor-lambda:install && npm run cdk:monitor-lambda:test && cdk synth --all"
  },
  "devDependencies": {
    "@swc/core": "^1.16.13",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30",
    "@types/node": "^26.6.4",
    "jest": "^30",
    "aws-cdk": "2.1144.0",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.272.0",
    "constructs": "^10.5.0"
  }
}
